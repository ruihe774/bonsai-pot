#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require

// Q1_0 weights × Q8_0 activations -> f16 output, using int8 cooperative
// matrix MMAs (VK_KHR_cooperative_matrix). The int8 inputs (with int32
// accumulator) replace the dotPacked4x8EXT inner loop in the dp4a sibling
// kernel `matmul_q1_0_q8_0.comp`.
//
// Tiling:
//   * 64 × 64 WG tile (TILE_M × TILE_N).
//   * K accumulated in 128-element Q1_0 blocks; each Q1_0 block contains
//     four 32-element Q8_0 sub-blocks. The sub-block boundary matters
//     because Q8_0 activation scales `a_d[r,b,s]` change across `s` —
//     per-block i32 partials must be scaled before being folded into the
//     fp32 accumulator.
//   * 4 subgroups per WG (WG=128, sg=32 fixed). Subgroups are arranged
//     2 × 2 over the 64 × 64 WG tile, so each subgroup handles a 32 × 32
//     sub-tile = 4 spatial 16 × 16 MMAs.
//   * Per Q8_0 sub-block: each spatial MMA chains 2 K=16 cooperative
//     multiply-adds.
//
// Scaling. KHR cooperative matrices have no element-wise scale primitive
// (scope is Subgroup; element layout is opaque), so per Q8_0 sub-block we
// `coopMatStore` the i32 partial into shared memory, then every thread
// reads its cell footprint, applies `a_d[r]·w_d[c]`, and folds into a
// register-resident fp32 accumulator.
//
// To keep the scale-and-accumulate step from costing a workgroup barrier
// per sub-block, the i32 dump is **subgroup-private** (one 32 × 32 region
// per subgroup, contiguous in `i32_dump_sg`), and the per-thread cell
// layout is aligned with the 2 × 2 subgroup grid: each subgroup's 32 lanes
// are arranged as an 8 × 4 (lx_sg × ly_sg) thread grid over its 32 × 32
// sub-tile, so each thread owns 4 (TN) × 8 (TM) cells inside the
// subgroup's private region. The s-loop's barriers are then `subgroupBarrier()`
// calls (intra-subgroup memory + execution sync) instead of full
// workgroup barriers — total per Q1_0 block: 1 WG barrier (after
// cooperative loads) + 8 subgroup barriers + 1 WG barrier (before next
// block's cooperative loads). The previous layout had 9 WG barriers per
// block.
//
// Caller bind-group layout matches `matmul_q1_0_q8_0.comp`
// (the `bgls.matmul` BGL): {weights ro, acts ro, y rw}, with the same
// `MatmulParams` push constant.
layout(push_constant) uniform Params {
    uint k;
    uint n;
    uint m;
    uint w_d_offset;
    uint w_qs_offset;
    uint a_d_offset;
    uint a_qs_offset;
    uint out_offset;
    uint accumulate;
}
p;

layout(set = 0, binding = 0, std430) readonly buffer WBuf { uint weights[]; };
layout(set = 0, binding = 1, std430) readonly buffer ABuf { uint acts[]; };
layout(set = 0, binding = 2, std430) buffer YBuf { float16_t y[]; };

const uint TILE_M = 64u;
const uint TILE_N = 64u;
const uint TILE_K = 128u;          // one Q1_0 block
const uint MMA = 16u;              // sint8 / sint8 / sint32 16×16×16
const uint WG = 128u;
const uint SG_SIZE = 32u;
const uint NUM_SG = WG / SG_SIZE;  // 4
const uint SG_M_GRID = 2u;
const uint SG_N_GRID = 2u;
const uint SG_TILE_M = TILE_M / SG_M_GRID;   // 32
const uint SG_TILE_N = TILE_N / SG_N_GRID;   // 32
const uint SG_MMA_M = SG_TILE_M / MMA;       // 2
const uint SG_MMA_N = SG_TILE_N / MMA;       // 2

// Per-subgroup thread grid: 32 lanes laid out 16 (n) × 2 (m) over the
// subgroup's 32 × 32 sub-tile, so each thread owns a TM × TN = 16 × 2
// cell block (32 cells/thread). The wide n-direction lane count (16)
// keeps the dump-read bank-conflict pattern at 2-way per wave32 (matching
// the legacy WG-wide 16×8 layout); a narrower n-direction grid like 8 × 4
// would land on a 4-way conflict because the 32-bank LDS modulo-aliases
// columns at stride 4.
const uint SG_LX = 16u;            // n-direction lanes within a subgroup
const uint SG_LY = 2u;             // m-direction lanes within a subgroup
const uint TM = SG_TILE_M / SG_LY; // 16
const uint TN = SG_TILE_N / SG_LX; // 2

// Shared memory. Total ≈ 33 KiB — fits within the 64 KiB LDS budget on
// every adapter we target. Layouts:
//   * a_lds_u : [M=64, K_u=32] row-major (8 KiB) — Q8_0 i8 acts packed
//               4-per-uint (each uint is one Q8_0 4-byte word).
//   * b_lds_u : [N=64, K_u=32] row-major (8 KiB) — ±1 i8 weights packed
//               4-per-uint after sign-bit expansion. coopmat B-side loads
//               use ColumnMajor with stride = K_U (uints).
//   * a_d_lds  : [4, M=64], indexed [s*64 + m_local] (1 KiB)
//   * w_d_lds  : [N=64] (256 B)
//   * i32_dump_sg : NUM_SG × [SG_TILE_M=32, SG_TILE_N=32] row-major (16 KiB).
//                   Each subgroup writes only its own 4 KiB slice; reads
//                   stay subgroup-local, so the s-loop never needs a
//                   workgroup barrier.
//
// LDS is declared as `uint[]` rather than `int8_t[]` so the cooperative
// loads (4 i8 per uint) collapse to a single 32-bit shared store instead
// of four `ds_write_b8` instructions. The cooperative-matrix load reads
// the matrix as int8 elements; glslang lowers `coopMatLoad(mat_i8, uint[],
// elemOffset, stride, ...)` with elemOffset/stride measured in *buffer*
// elements (i.e. uints), so K-direction offsets/strides are scaled by 4
// at the call site.
const uint K_U = TILE_K / 4u;     // 32 uints per row of A or B^T LDS view
shared uint a_lds_u[TILE_M * K_U];
shared uint b_lds_u[TILE_N * K_U];
shared float a_d_lds[TILE_M * 4u];
shared float w_d_lds[TILE_N];
shared int32_t i32_dump_sg[NUM_SG * SG_TILE_M * SG_TILE_N];

float load_w_f16(uint b_offset) {
    uint word = weights[b_offset >> 2];
    uint half_bits = (word >> ((b_offset & 2u) * 8u)) & 0xFFFFu;
    return unpackFloat2x16(half_bits).x;
}

// Spread 4 sign bits into a packed u32 of ±1 bytes: bit=1 → +1, bit=0 → -1.
// Same trick as `expand_4_bits` in the dp4a sibling — bit i lands at the
// LSB of byte i, then `~(x * 0xFE)` yields 0x01 / 0xFF which cast to int8
// is ±1.
uint expand_4_bits(uint bits) {
    uint spread = (bits * 0x00204081u) & 0x01010101u;
    return ~(spread * 0xFEu);
}

layout(local_size_x = WG, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint n_base = gl_WorkGroupID.x * TILE_N;
    uint m_base = gl_WorkGroupID.y * TILE_M;
    uint nb_q1 = p.k / 128u;
    uint nb_q8 = p.k / 32u;
    uint tid = gl_LocalInvocationIndex;

    uint sg_id = gl_SubgroupID;            // [0, 4)
    uint sg_m_idx = sg_id / SG_N_GRID;     // [0, 2)
    uint sg_n_idx = sg_id % SG_N_GRID;     // [0, 2)
    uint sg_m_off = sg_m_idx * SG_TILE_M;
    uint sg_n_off = sg_n_idx * SG_TILE_N;
    uint sg_dump_base = sg_id * (SG_TILE_M * SG_TILE_N);

    uint inv = gl_SubgroupInvocationID;
    uint lx_sg = inv % SG_LX;              // [0, 8)
    uint ly_sg = inv / SG_LX;              // [0, 4)

    float acc[TM * TN];
    [[unroll]] for (uint i = 0u; i < TM * TN; ++i) acc[i] = 0.0;

    [[unroll, min_iterations(4), iteration_multiple(1), dependency_length(1)]]
    for (uint b = 0u; b < nb_q1; ++b) {
        // ---- cooperative loads for one Q1_0 block ------------------------

        // w_d (Q1_0 weight scales): one f16 per (n_idx, b). 64 entries.
        if (tid < TILE_N) {
            uint n_idx = n_base + tid;
            w_d_lds[tid] = load_w_f16(p.w_d_offset + (n_idx * nb_q1 + b) * 2u);
        }

        // a_d (Q8_0 activation scales): one f32 per (m_idx, b, s). 4*64=256
        // entries; WG=128 → 2 entries per thread.
        [[unroll]] for (uint i = 0u; i < 2u; ++i) {
            uint idx = i * WG + tid;
            uint s = idx / TILE_M;
            uint m_local = idx % TILE_M;
            uint m_idx = m_base + m_local;
            uint a_block = b * 4u + s;
            uint off = p.a_d_offset + (m_idx * nb_q8 + a_block) * 4u;
            a_d_lds[idx] = uintBitsToFloat(acts[off >> 2]);
        }

        // b_lds_u: expand Q1_0 sign bits → ±1 packed-byte u32. Each Q1_0
        // row is 16 bytes = 4 u32 of sign bits (32 K-elements per u32).
        // Layout in shmem is [N=64, K_U=32] row-major (each uint = 4 ±1
        // bytes), so each weight u32-load expands into 8 packed-byte u32
        // stores. Total work = 64 × 4 = 256 u32 reads → 2 per thread.
        [[unroll]] for (uint i = 0u; i < 2u; ++i) {
            uint idx = i * WG + tid;
            uint n_local = idx / 4u;
            uint w_word = idx & 3u;
            uint n_idx = n_base + n_local;
            uint off = p.w_qs_offset + n_idx * (nb_q1 * 16u) + b * 16u + w_word * 4u;
            uint bits = weights[off >> 2];
            // Each w_word covers 32 i8 = 8 uints in the [N, K_U] LDS view.
            uint dst_u = n_local * K_U + w_word * 8u;
            [[unroll]] for (uint q = 0u; q < 8u; ++q) {
                b_lds_u[dst_u + q] = expand_4_bits((bits >> (q * 4u)) & 0xFu);
            }
        }

        // a_lds_u: load Q8_0 i8 acts. [M=64, K_U=32] row-major (each uint
        // = one Q8_0 4-byte word), 8192 bytes; each m row has 32 u32 =
        // 128 i8 K-elements per Q1_0 block. Total work = 64 × 32 = 2048
        // u32 reads → 16 per thread. Storing the raw u32 keeps the i8
        // values byte-aligned for the cooperative load that interprets
        // them as int8 elements.
        [[unroll]] for (uint i = 0u; i < 16u; ++i) {
            uint idx = i * WG + tid;
            uint m_local = idx / 32u;
            uint k_word = idx & 31u;
            uint m_idx = m_base + m_local;
            uint off = p.a_qs_offset + m_idx * p.k + b * 128u + k_word * 4u;
            a_lds_u[m_local * K_U + k_word] = acts[off >> 2];
        }
        barrier();

        // ---- Q8_0 sub-block loop -----------------------------------------
        [[unroll]] for (uint s = 0u; s < 4u; ++s) {
            uint k_block = s * 32u;

            // Each subgroup MMAs its 32 × 32 sub-tile → 4 spatial 16×16
            // i32 partials → coopMatStore into the subgroup's private
            // region of `i32_dump_sg` (no overlap with other subgroups,
            // so the only sync needed is intra-subgroup).
            [[unroll]] for (uint mma_m = 0u; mma_m < SG_MMA_M; ++mma_m) {
                [[unroll]] for (uint mma_n = 0u; mma_n < SG_MMA_N; ++mma_n) {
                    uint m_off = sg_m_off + mma_m * MMA;
                    uint n_off = sg_n_off + mma_n * MMA;

                    coopmat<int32_t, gl_ScopeSubgroup, MMA, MMA, gl_MatrixUseAccumulator> partial =
                        coopmat<int32_t, gl_ScopeSubgroup, MMA, MMA, gl_MatrixUseAccumulator>(0);

                    [[unroll]] for (uint tk = 0u; tk < 2u; ++tk) {
                        uint k_off = k_block + tk * MMA;

                        coopmat<int8_t, gl_ScopeSubgroup, MMA, MMA, gl_MatrixUseA> a_mat;
                        coopmat<int8_t, gl_ScopeSubgroup, MMA, MMA, gl_MatrixUseB> b_mat;

                        // a_lds_u / b_lds_u are uint[]; glslang scales
                        // elemOffset & stride by the buffer element size,
                        // so K-direction quantities are in uint units
                        // (i8s / 4). k_off is always uint-aligned (32-elem
                        // sub-block × 16-elem MMA chunks).
                        uint k_off_u = k_off >> 2;
                        coopMatLoad(a_mat, a_lds_u,
                                    m_off * K_U + k_off_u, K_U,
                                    gl_CooperativeMatrixLayoutRowMajor);
                        coopMatLoad(b_mat, b_lds_u,
                                    n_off * K_U + k_off_u, K_U,
                                    gl_CooperativeMatrixLayoutColumnMajor);

                        partial = coopMatMulAdd(a_mat, b_mat, partial);
                    }

                    // Subgroup-local store: stride = SG_TILE_N (=32).
                    uint dump_off =
                        sg_dump_base + (mma_m * MMA) * SG_TILE_N + (mma_n * MMA);
                    coopMatStore(partial, i32_dump_sg, dump_off, SG_TILE_N,
                                 gl_CooperativeMatrixLayoutRowMajor);
                }
            }
            // Make the coopMatStore visible to the per-thread reads below
            // within this subgroup. Other subgroups are independent — no
            // workgroup barrier needed.
            subgroupBarrier();

            // Per-thread scale and accumulate. Each thread reads only its
            // own subgroup's private region, so the layout of (m_local,
            // n_local) addresses is `sg_m_off + ly_sg*TM + tm`,
            // `sg_n_off + lx_sg*TN + tn`. The Q1_0 weight scale `w_d` is
            // per-(n, b), and the Q8_0 activation scale `a_d` is
            // per-(m, b, s); both are loaded once per b-iteration.
            // Hoist a_d / w_d into registers to skip per-iteration LDS reads.
            float a_d_reg[TM];
            [[unroll]] for (uint tm = 0u; tm < TM; ++tm) {
                uint m_local = sg_m_off + ly_sg * TM + tm;
                a_d_reg[tm] = a_d_lds[s * TILE_M + m_local];
            }
            float w_d_reg[TN];
            [[unroll]] for (uint tn = 0u; tn < TN; ++tn) {
                uint n_local = sg_n_off + lx_sg * TN + tn;
                w_d_reg[tn] = w_d_lds[n_local];
            }
            [[unroll]] for (uint tm = 0u; tm < TM; ++tm) {
                uint r = ly_sg * TM + tm;
                [[unroll]] for (uint tn = 0u; tn < TN; ++tn) {
                    uint c = lx_sg * TN + tn;
                    int32_t pi = i32_dump_sg[sg_dump_base + r * SG_TILE_N + c];
                    acc[tm * TN + tn] += a_d_reg[tm] * w_d_reg[tn] * float(pi);
                }
            }
            // WAR fence: ensure all reads above complete before the next
            // sub-block's coopMatStore overwrites this subgroup's region.
            subgroupBarrier();
        }
    }

    // ---- output write ----------------------------------------------------
    [[unroll]] for (uint tm = 0u; tm < TM; ++tm) {
        uint m_idx = m_base + sg_m_off + ly_sg * TM + tm;
        if (m_idx >= p.m) continue;
        [[unroll]] for (uint tn = 0u; tn < TN; ++tn) {
            uint n_idx = n_base + sg_n_off + lx_sg * TN + tn;
            if (n_idx >= p.n) continue;
            uint yi = p.out_offset + m_idx * p.n + n_idx;
            float val = acc[tm * TN + tn];
            if (p.accumulate != 0u) {
                y[yi] = float16_t(float(y[yi]) + val);
            } else {
                y[yi] = float16_t(val);
            }
        }
    }
}
