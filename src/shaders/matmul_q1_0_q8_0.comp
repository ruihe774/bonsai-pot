#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_control_flow_attributes2 : require

// dotPacked4x8EXT matmul: Q1_0 weights × Q8_0 activations -> f16 output.
//
// 64×64 tile, 256 threads, each thread = 4×4 = 16 cells.

layout(push_constant) uniform Params {
    uint k;
    uint n;
    uint m;
    uint w_d_offset;
    uint w_qs_offset;
    uint a_d_offset;
    uint a_qs_offset;
    uint out_offset;
    uint accumulate;
}
p;

layout(set = 0, binding = 0, std430) readonly buffer WBuf { uint weights[]; };
layout(set = 0, binding = 1, std430) readonly buffer ABuf { uint acts[]; };
layout(set = 0, binding = 2, std430) buffer YBuf { float16_t y[]; };

const uint WG_N = 16u;
const uint WG_M = 16u;
const uint WG = 256u;
const uint TN = 4u;
const uint TM = 4u;
const uint TILE_N = 64u;
const uint TILE_M = 64u;

shared float w_d_lds[64];
shared uint w_bits_lds[256];
shared float a_d_lds[256];
shared uint a_qs_lds[2048];

float load_w_f16(uint b_offset) {
    uint word = weights[b_offset >> 2];
    uint half_bits = (word >> ((b_offset & 2u) * 8u)) & 0xFFFFu;
    return unpackFloat2x16(half_bits).x;
}

uint expand_4_bits(uint bits) {
    // Spread the 4 input bits to the 4 byte LSBs in one mul: bit i lands at bit (8i)
    // because 0x00204081 has bits set at positions {0, 7, 14, 21}.
    uint spread = (bits * 0x00204081u) & 0x01010101u;
    return ~(spread * 0xFEu);
}

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint n_base = gl_WorkGroupID.x * TILE_N;
    uint m_base = gl_WorkGroupID.y * TILE_M;
    uint nb_q1 = p.k / 128u;
    uint nb_q8 = p.k / 32u;
    uint tid = gl_LocalInvocationIndex;

    uint lx = tid % WG_N;
    uint ly = tid / WG_N;

    float acc[16];
    [[unroll]] for (uint i = 0u; i < 16u; ++i)
        acc[i] = 0.0;

    // Bonsai's matmul callers guarantee tile alignment / activation buffer
    // padding; OOB loads stay in LDS slots only their owner consults, and
    // final writes are gated by m_idx < p.m.
    //
    // Loop hints: every Bonsai matmul caller picks K as a multiple of 512
    // (n_embd=2560/3072, q_dim=2048, ffn=9728), so nb_q1 = K/128 is always a
    // multiple of 4 and at least 16 (smallest case is Wo on 4B). The acc[]
    // update is a length-1 loop carry (associative reduction).
    [[unroll, min_iterations(16), iteration_multiple(4), dependency_length(1)]]
    for (uint b = 0u; b < nb_q1; ++b) {
        // ---- Cooperative loads ----
        if (tid < 64u) {
            uint n_idx = n_base + tid;
            w_d_lds[tid] = load_w_f16(p.w_d_offset + (n_idx * nb_q1 + b) * 2u);
        }
        {
            uint n_local = tid / 4u;
            uint s = tid % 4u;
            uint n_idx = n_base + n_local;
            uint off = p.w_qs_offset + n_idx * (nb_q1 * 16u) + b * 16u + s * 4u;
            w_bits_lds[s * 64u + n_local] = weights[off >> 2];
        }
        {
            uint s = tid / 64u;
            uint m_local = tid % 64u;
            uint m_idx = m_base + m_local;
            uint a_block = b * 4u + s;
            uint off = p.a_d_offset + (m_idx * nb_q8 + a_block) * 4u;
            a_d_lds[s * 64u + m_local] = uintBitsToFloat(acts[off >> 2]);
        }
        [[unroll]] for (uint li = 0u; li < 8u; ++li) {
            uint idx = li * WG + tid;
            uint m_local = idx / 32u;
            uint su = idx % 32u;
            uint m_idx = m_base + m_local;
            uint off = p.a_qs_offset + m_idx * p.k + b * 128u + su * 4u;
            a_qs_lds[m_local * 32u + su] = acts[off >> 2];
        }
        barrier();

        float wd[TN];
        [[unroll]] for (uint tn = 0u; tn < TN; ++tn) { wd[tn] = w_d_lds[lx * TN + tn]; }

        [[unroll]] for (uint s = 0u; s < 4u; ++s) {
            uint w[TN][8];
            [[unroll]] for (uint tn = 0u; tn < TN; ++tn) {
                uint bw = w_bits_lds[s * 64u + lx * TN + tn];
                [[unroll]] for (uint i = 0u; i < 8u; ++i) { w[tn][i] = expand_4_bits((bw >> (i * 4u)) & 0xFu); }
            }

            [[unroll]] for (uint tm = 0u; tm < TM; ++tm) {
                uint m_local = ly * TM + tm;
                float a_d = a_d_lds[s * 64u + m_local];
                uint a_base = m_local * 32u + s * 8u;
                uint a[8];
                [[unroll]] for (uint i = 0u; i < 8u; ++i) { a[i] = a_qs_lds[a_base + i]; }

                int sumi[TN];
                [[unroll]] for (uint tn = 0u; tn < TN; ++tn)
                    sumi[tn] = 0;
                [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                    [[unroll]] for (uint tn = 0u; tn < TN; ++tn) {
                        sumi[tn] = dotPacked4x8EXT(int(w[tn][i]), int(a[i])) + sumi[tn];
                    }
                }

                [[unroll]] for (uint tn = 0u; tn < TN; ++tn) { acc[tm * TN + tn] += a_d * wd[tn] * float(sumi[tn]); }
            }
        }
        barrier();
    }

    [[unroll]] for (uint tm = 0u; tm < TM; ++tm) {
        uint m_idx = m_base + ly * TM + tm;
        if (m_idx >= p.m)
            continue;
        [[unroll]] for (uint tn = 0u; tn < TN; ++tn) {
            uint n_idx = n_base + lx * TN + tn;
            if (n_idx >= p.n)
                continue;
            uint yi = p.out_offset + m_idx * p.n + n_idx;
            float val = acc[tm * TN + tn];
            if (p.accumulate != 0u) {
                y[yi] = float16_t(float(y[yi]) + val);
            } else {
                y[yi] = float16_t(val);
            }
        }
    }
}
