#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require

// Fused: y = rms_norm(x) * w  →  Q8_0 quantize  →  write to act_q8.
//
// Replaces the prefill-path pair `rms_norm` (writes act.x_norm) +
// `quantize_q8_0` (reads act.x_norm, writes act_q8). The fused version keeps
// the normalized values in registers and never touches act.x_norm.
//
// Output layout (matches `quantize_q8_0`):
//   d (f32):  outbuf[d_offset/4 + token*nb_q8 + b]
//   qs (i8):  outbuf[qs_offset/4 + (token*k + b*32)/4 + sub] for sub in 0..8
//
// dispatch: (m, 1, 1) — one workgroup per token.

layout(constant_id = 0) const uint SUBGROUP_SIZE = 32;

layout(push_constant) uniform Params {
    uint k;             // input dim, multiple of 256
    uint input_offset;  // f16 elements
    uint weight_offset; // f16 elements (k weights, reused across tokens)
    uint d_offset;      // bytes (Q8_0 d-section, FP32 scales)
    uint qs_offset;     // bytes (Q8_0 qs-section, packed i8)
    float eps;
}
p;

layout(set = 0, binding = 0, std430) readonly buffer ActBuf { float16_t act[]; };
layout(set = 0, binding = 1, std430) readonly buffer WBuf { float16_t w[]; };
layout(set = 0, binding = 2, std430) buffer OutBuf { uint outbuf[]; };

const uint WG = 256u;
const uint BLOCK_SIZE = 32u;
const uint BLOCKS_PER_ITER = WG / BLOCK_SIZE; // 8
const uint NUM_SUBGROUPS = (WG + SUBGROUP_SIZE - 1u) / SUBGROUP_SIZE;

shared float sg_partial[NUM_SUBGROUPS];
shared float inv_h_sh;
shared uint qv_sh[256];

float wg_sum_f32(float local_v) {
    float sg_sum = subgroupAdd(local_v);
    if (NUM_SUBGROUPS == 1u)
        return sg_sum;
    if (gl_SubgroupInvocationID == 0u)
        sg_partial[gl_SubgroupID] = sg_sum;
    barrier();
    if (gl_SubgroupID == 0u) {
        // NUM_SUBGROUPS can exceed SUBGROUP_SIZE (e.g. WG=256 with SG=8 →
        // NUM_SUBGROUPS=32). Each merging lane folds every k*SUBGROUP_SIZE-th
        // partial before the final subgroupAdd. The loop bound is constant
        // after specialization, so spirv-opt folds it for the common
        // NUM_SUBGROUPS <= SUBGROUP_SIZE case.
        float c = 0.0;
        for (uint i = gl_SubgroupInvocationID; i < NUM_SUBGROUPS; i += SUBGROUP_SIZE) {
            c += sg_partial[i];
        }
        float f = subgroupAdd(c);
        if (gl_SubgroupInvocationID == 0u)
            sg_partial[0] = f;
    }
    barrier();
    return sg_partial[0];
}

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint token_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint nb_q8 = p.k / BLOCK_SIZE;
    uint in_base = p.input_offset + token_idx * p.k;
    uint qs_token_byte = p.qs_offset + token_idx * p.k;
    uint d_token_word = (p.d_offset >> 2) + token_idx * nb_q8;

    // ---- Phase 1: rms_norm sum-of-squares ----
    float s = 0.0;
    for (uint i = tid; i < p.k; i += WG) {
        float v = float(act[in_base + i]);
        s += v * v;
    }
    float total_sq = wg_sum_f32(s);
    if (tid == 0u) {
        inv_h_sh = inversesqrt(total_sq / float(p.k) + p.eps);
    }
    barrier();
    float inv_h = inv_h_sh;

    // ---- Phase 2: per-block normalize + Q8_0 quantize ----
    uint lane_in_block = tid & 31u;
    uint block_within_iter = tid >> 5;
    uint sg_block_base = gl_SubgroupInvocationID & ~31u;

    uint n_iters = nb_q8 / BLOCKS_PER_ITER;
    for (uint it = 0u; it < n_iters; ++it) {
        uint block_global = it * BLOCKS_PER_ITER + block_within_iter;
        uint elem_idx = it * WG + tid;
        float v = float(act[in_base + elem_idx]) * inv_h * float(w[p.weight_offset + elem_idx]);

        // Per-32-lane max-abs reduction. Masks 1/2/4 are always safe
        // (SUBGROUP_SIZE >= 8 enforced at load time); masks 8/16 only when
        // the subgroup is wide enough to keep the XOR partner in-subgroup.
        // When the subgroup is smaller than 32, no single cluster covers a
        // full 32-block, so we stitch the in-subgroup partials through
        // `sg_partial` (same scheme as kv_writeback_fused).
        float m = abs(v);
        m = max(m, subgroupShuffleXor(m, 1u));
        m = max(m, subgroupShuffleXor(m, 2u));
        m = max(m, subgroupShuffleXor(m, 4u));
        if (SUBGROUP_SIZE >= 16u) {
            m = max(m, subgroupShuffleXor(m, 8u));
        }
        if (SUBGROUP_SIZE >= 32u) {
            m = max(m, subgroupShuffleXor(m, 16u));
        }
        if (SUBGROUP_SIZE < 32u) {
            uint sg_lane = tid % SUBGROUP_SIZE;
            uint cluster_id = tid / SUBGROUP_SIZE;
            if (sg_lane == 0u) {
                sg_partial[cluster_id] = m;
            }
            barrier();
            uint group_id = tid >> 5;             // which 32-block within the WG
            uint per_group = 32u / SUBGROUP_SIZE; // 4 (sg=8) or 2 (sg=16)
            uint g_base = group_id * per_group;
            float mm = 0.0;
            [[unroll]]
            for (uint i = 0u; i < per_group; ++i) {
                mm = max(mm, sg_partial[g_base + i]);
            }
            barrier();
            m = mm;
        }
        float id_inv = mix(0.0, 127.0 / m, m != 0.0);
        uint qv = uint(int(clamp(round(v * id_inv), -127.0, 127.0))) & 0xFFu;

        // Pack 4 bytes per u32 (subgroup-shuffle path or LDS-staging fallback).
        uint packed;
        if (SUBGROUP_SIZE >= 32u) {
            uint group4_in_block = lane_in_block & ~3u;
            uint tgt = sg_block_base | group4_in_block;
            packed = subgroupShuffle(qv, tgt + 0u) | (subgroupShuffle(qv, tgt + 1u) << 8) |
                     (subgroupShuffle(qv, tgt + 2u) << 16) | (subgroupShuffle(qv, tgt + 3u) << 24);
        } else {
            qv_sh[tid] = qv;
            barrier();
            uint base = (block_within_iter * 32u) + (lane_in_block & ~3u);
            packed = qv_sh[base + 0u] | (qv_sh[base + 1u] << 8) | (qv_sh[base + 2u] << 16) | (qv_sh[base + 3u] << 24);
            barrier();
        }
        if ((lane_in_block & 3u) == 0u) {
            uint qs_byte = qs_token_byte + block_global * 32u + lane_in_block;
            outbuf[qs_byte >> 2] = packed;
        }
        if (lane_in_block == 0u) {
            outbuf[d_token_word + block_global] = floatBitsToUint(m / 127.0);
        }
    }
}
