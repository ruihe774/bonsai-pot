#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// RMSNorm: y = x * rsqrt(mean(x^2) + eps) * w
// The cross-subgroup-merge shmem is sized using SUBGROUP_MIN_SIZE as a
// specialization constant (SpecId 0). At pipeline creation we patch the
// OpSpecConstant default to the adapter's actual subgroup_min_size, so this
// single binary serves all hardware. The follow-on SPIR-V optimizer folds
// the post-specialization expression for SG_PARTIAL_MAX so the array lands
// at exactly the right size.
//
// dispatch: (n_groups, 1, 1)

layout(constant_id = 0) const uint SUBGROUP_MIN_SIZE = 32;

const uint WG = 512;
// Worst-case number of subgroups per workgroup. Drives the cross-subgroup
// shmem size. The actual subgroup count comes from gl_NumSubgroups at runtime.
const uint SG_PARTIAL_MAX = (WG + SUBGROUP_MIN_SIZE - 1) / SUBGROUP_MIN_SIZE;

layout(push_constant) uniform Params {
    uint group_size;
    uint n_groups;
    uint input_offset;
    uint output_offset;
    uint weight_offset;
    float eps;
} p;

layout(set = 0, binding = 0, std430) buffer ActBuf {
    float16_t act[];
};

layout(set = 0, binding = 1, std430) readonly buffer WBuf {
    float16_t w[];
};

shared float sg_partial[SG_PARTIAL_MAX];

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint gi = gl_WorkGroupID.x;
    if (gi >= p.n_groups) return;
    uint tid = gl_LocalInvocationID.x;
    uint n = p.group_size;
    uint in_base = p.input_offset + gi * n;
    uint out_base = p.output_offset + gi * n;

    float s = 0.0;
    for (uint i = tid; i < n; i += WG) {
        float v = float(act[in_base + i]);
        s += v * v;
    }

    // Workgroup-wide sum: subgroupAdd within subgroup, then if num_subgroups > 1
    // merge per-subgroup totals via shmem and a second subgroupAdd in sg 0.
    float sg_sum = subgroupAdd(s);
    float total;
    if (gl_NumSubgroups == 1u) {
        total = sg_sum;
    } else {
        if (gl_SubgroupInvocationID == 0u) {
            sg_partial[gl_SubgroupID] = sg_sum;
        }
        barrier();
        if (gl_SubgroupID == 0u) {
            float combined = 0.0;
            if (gl_SubgroupInvocationID < gl_NumSubgroups) {
                combined = sg_partial[gl_SubgroupInvocationID];
            }
            float final_sum = subgroupAdd(combined);
            if (gl_SubgroupInvocationID == 0u) {
                sg_partial[0] = final_sum;
            }
        }
        barrier();
        total = sg_partial[0];
    }

    float16_t inv_h = float16_t(inversesqrt(total / float(n) + p.eps));
    for (uint i = tid; i < n; i += WG) {
        act[out_base + i] = act[in_base + i] * inv_h * w[p.weight_offset + i];
    }
}
