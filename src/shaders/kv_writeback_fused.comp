#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_control_flow_attributes2 : require

// Fused per-layer K-side pre-KV pipeline:
//   rms_norm(K head) -> *w_k_norm -> NEOX-RoPE -> Q8_0 quantize -> write kv_k.
// V-side runs in the same workgroup: Q8_0 quantize + write kv_v (no rms, no
// rope). Replaces a 3-dispatch sequence (rms_norm K, rope K, kv_writeback)
// with 1.
//
// Workgroup = head_dim (128). One workgroup per (kv_head, token) writes one
// head's worth of K and V into the cache. Dispatch (n_kv_head, m_tokens, 1).

layout(constant_id = 0) const uint SUBGROUP_SIZE = 32;

layout(push_constant) uniform Params {
    uint k_cur_off;          // f16 element offset of K_cur in act
    uint v_cur_off;          // f16 element offset of V_cur in act
    uint w_k_norm_off;       // f16 element offset of w_k_norm[0..head_dim] in w_norms
    uint rope_offset;        // f16 element base offset into rope_cs (typically 0)
    uint dst_d_word_offset;  // u32-word offset into kv_{k,v} d-section, layer base
    uint dst_qs_byte_offset; // byte offset into kv_{k,v} qs-section, layer base
    uint pos_base;           // first absolute cache position to write into
    uint kv_dim;             // = n_kv_head * head_dim
    uint nb_per_row;         // = kv_dim / 32
    float eps;
}
p;

layout(set = 0, binding = 0, std430) readonly buffer ActBuf { float16_t act[]; };
layout(set = 0, binding = 1, std430) readonly buffer WBuf { float16_t w_norms[]; };
layout(set = 0, binding = 2, std430) readonly buffer RopeBuf { float16_t rope_cs[]; };
layout(set = 0, binding = 3, std430) buffer KBuf { uint kv_k[]; };
layout(set = 0, binding = 4, std430) buffer VBuf { uint kv_v[]; };

const uint HEAD_DIM = 128u;
const uint HALF_DIM = 64u;
const uint NB_PER_HEAD = HEAD_DIM / 32u;
const uint WG = 128u;
const uint NUM_SUBGROUPS = (WG + SUBGROUP_SIZE - 1u) / SUBGROUP_SIZE;

// k_sh holds normed-and-weighted K so RoPE can fetch the pair partner across
// the head-half boundary.
shared float16_t k_sh[128];
// Used by the RMS cross-subgroup merge (slot 0..NUM_SUBGROUPS; only .x), and
// by the amax cross-cluster merge (writes both .x=K, .y=V) when
// SUBGROUP_SIZE < 32.
shared vec2 sg_partial[NUM_SUBGROUPS];

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint head = gl_WorkGroupID.x;
    uint tok = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;

    uint kv_token_off = tok * p.kv_dim + head * HEAD_DIM;
    float k_raw = float(act[p.k_cur_off + kv_token_off + tid]);
    float v_raw = float(act[p.v_cur_off + kv_token_off + tid]);

    // ---- RMS-norm reduction over the K head (sum of squares) ----
    float sg_sum = subgroupAdd(k_raw * k_raw);
    float total;
    if (NUM_SUBGROUPS == 1u) {
        total = sg_sum;
    } else {
        if (gl_SubgroupInvocationID == 0u)
            sg_partial[gl_SubgroupID].x = sg_sum;
        barrier();
        if (gl_SubgroupID == 0u) {
            float c = 0.0;
            if (gl_SubgroupInvocationID < NUM_SUBGROUPS)
                c = sg_partial[gl_SubgroupInvocationID].x;
            float f = subgroupAdd(c);
            if (gl_SubgroupInvocationID == 0u)
                sg_partial[0].x = f;
        }
        barrier();
        total = sg_partial[0].x;
    }
    float inv_h = inversesqrt(total / float(HEAD_DIM) + p.eps);

    // ---- norm * weight, stash to shmem so RoPE can swap pairs ----
    k_sh[tid] = float16_t(k_raw * inv_h) * w_norms[p.w_k_norm_off + tid];
    barrier();

    // ---- NEOX RoPE: each lane computes its own output, kept in a register ----
    uint pos_abs = p.pos_base + tok;
    uint cs_base = p.rope_offset + pos_abs * HEAD_DIM;
    float16_t k_post_h;
    if (tid < HALF_DIM) {
        float16_t c = rope_cs[cs_base + tid * 2u];
        float16_t s = rope_cs[cs_base + tid * 2u + 1u];
        k_post_h = k_sh[tid] * c - k_sh[tid + HALF_DIM] * s;
    } else {
        uint j = tid - HALF_DIM;
        float16_t c = rope_cs[cs_base + j * 2u];
        float16_t s = rope_cs[cs_base + j * 2u + 1u];
        k_post_h = k_sh[j] * s + k_sh[tid] * c;
    }
    float k_post = float(k_post_h);

    // ---- Per-32-block amax for K and V via subgroup butterfly ----
    // Masks 1/2/4 are always safe (SUBGROUP_SIZE >= 8 enforced at load time);
    // 8/16 are gated by SUBGROUP_SIZE (folded after specialization). The
    // stitch path runs only when SUBGROUP_SIZE < 32 (no cluster covers a
    // full 32-block).
    float ak = abs(k_post);
    float av = abs(v_raw);

    ak = max(ak, subgroupShuffleXor(ak, 1u));
    av = max(av, subgroupShuffleXor(av, 1u));
    ak = max(ak, subgroupShuffleXor(ak, 2u));
    av = max(av, subgroupShuffleXor(av, 2u));
    ak = max(ak, subgroupShuffleXor(ak, 4u));
    av = max(av, subgroupShuffleXor(av, 4u));
    if (SUBGROUP_SIZE >= 16u) {
        ak = max(ak, subgroupShuffleXor(ak, 8u));
        av = max(av, subgroupShuffleXor(av, 8u));
    }
    if (SUBGROUP_SIZE >= 32u) {
        ak = max(ak, subgroupShuffleXor(ak, 16u));
        av = max(av, subgroupShuffleXor(av, 16u));
    }
    if (SUBGROUP_SIZE < 32u) {
        // Stitch the in-subgroup partials into per-32 blocks. Each cluster of
        // SUBGROUP_SIZE lanes contributes one entry; a 32-block spans
        // 32/SUBGROUP_SIZE entries (2 for SUBGROUP_SIZE=16, 4 for =8).
        uint sg_lane = tid % SUBGROUP_SIZE;
        uint cluster_id = tid / SUBGROUP_SIZE;
        if (sg_lane == 0u) {
            sg_partial[cluster_id] = vec2(ak, av);
        }
        barrier();
        uint group_id = tid >> 5;
        uint per_group = 32u / SUBGROUP_SIZE;
        uint g_base = group_id * per_group;
        float mk = 0.0;
        float mv = 0.0;
        // per_group is 4 for SUBGROUP_SIZE=8, 2 for SUBGROUP_SIZE=16 — both small.
        [[unroll, min_iterations(2), max_iterations(4), dependency_length(1)]]
        for (uint i = 0u; i < per_group; ++i) {
            vec2 m = sg_partial[g_base + i];
            mk = max(mk, m.x);
            mv = max(mv, m.y);
        }
        ak = mk;
        av = mv;
    }

    uint block_in_head = tid >> 5; // 0..3
    float inv_dk = mix(0.0, 127.0 / ak, ak != 0);
    float inv_dv = mix(0.0, 127.0 / av, av != 0);

    uint qk = uint(int(clamp(round(k_post * inv_dk), -127.0, 127.0))) & 0xFFu;
    uint qv = uint(int(clamp(round(v_raw * inv_dv), -127.0, 127.0))) & 0xFFu;

    // ---- Pack 4 bytes into one u32 via subgroup shuffle, write to cache ----
    // 4-lane clusters (tid % 4 == 0 lanes are the leaders) live entirely
    // within one subgroup since SUBGROUP_SIZE >= 8, so subgroupShuffle can
    // gather the partner bytes without going through shmem. Shuffles are
    // unconditional (uniform CF requirement); only the leader writes.
    uint cluster_base = gl_SubgroupInvocationID & ~3u;
    uint qk0 = subgroupShuffle(qk, cluster_base);
    uint qk1 = subgroupShuffle(qk, cluster_base + 1u);
    uint qk2 = subgroupShuffle(qk, cluster_base + 2u);
    uint qk3 = subgroupShuffle(qk, cluster_base + 3u);
    uint qv0 = subgroupShuffle(qv, cluster_base);
    uint qv1 = subgroupShuffle(qv, cluster_base + 1u);
    uint qv2 = subgroupShuffle(qv, cluster_base + 2u);
    uint qv3 = subgroupShuffle(qv, cluster_base + 3u);

    if ((tid & 3u) == 0u) {
        uint pk = qk0 | (qk1 << 8) | (qk2 << 16) | (qk3 << 24);
        uint pv = qv0 | (qv1 << 8) | (qv2 << 16) | (qv3 << 24);
        uint qs_byte_in_layer = p.dst_qs_byte_offset + pos_abs * p.kv_dim + head * HEAD_DIM + tid;
        kv_k[qs_byte_in_layer >> 2] = pk;
        kv_v[qs_byte_in_layer >> 2] = pv;
    }

    // d (FP32 scale) — one writer per block.
    if ((tid & 31u) == 0u) {
        uint block_global = pos_abs * p.nb_per_row + head * NB_PER_HEAD + block_in_head;
        kv_k[p.dst_d_word_offset + block_global] = floatBitsToUint(ak / 127.0);
        kv_v[p.dst_d_word_offset + block_global] = floatBitsToUint(av / 127.0);
    }
}
