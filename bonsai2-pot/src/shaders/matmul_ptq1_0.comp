#version 460

// PTQ1_0 × Q8/128 matmul for batched prefill:
//   Y[m][r] (=|+=) Σ_b d_w[r,b] · (d_a[m,b] · Σ_e trit[r,e] · q[m,e] − d_a[m,b] · Σ_e q[m,e])
// Up to three weight segments share the activation rows (like matvec_ptq1_0);
// segment s writes act[out_s + m * rows_s + r].
//
// Tile: 64 rows × 64 tokens per workgroup, 4 × 4 outputs per invocation.
// Per 128-element block the workgroup decodes the 64 weight rows into packed
// unsigned trits {0,1,2} (one u32 = four consecutive elements) in LDS — the
// base-3 residue trick yields elements 4i..4i+3 of a level from one qs word —
// stages the 64 token rows of Q8 activations, then runs 32 DP4a per output.
//
// dispatch: (total_rows / 64, ceil(m_tokens / 64), 1); segment row counts are
// multiples of 64.

layout(push_constant) uniform Params {
    uint nb;       // blocks per row (k / 128)
    uint m_tokens;
    uint q8_qs;    // q8 word offset of activation qs (row stride k/4 words)
    uint q8_d;     // q8 word offset of activation scales (row stride nb)
    uint q8_s;     // q8 word offset of activation scale*sums (row stride nb)
    uint seg1;
    uint seg2;
    uint w0;
    uint w1;
    uint w2;
    uint out0;
    uint out1;
    uint out2;
    uint total_rows;
    uint flags;    // bit 0: accumulate
}
p;

#define Q8_QUAL readonly
#include "lib/bindings.glsl"
#include "lib/ptq1_0.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint TR = 64u;
const uint TM = 64u;

shared uint w_sh[TR][33];   // trit words (+1 pad against bank conflicts)
shared uint a_sh[TM][33];   // activation words
shared float dw_sh[TR];
shared float da_sh[TM];
shared float ds_sh[TM];

// Pack the trits of one level of qs word lanes (vl: bytes 0,2; vh: bytes 1,3)
// into four bytes (elements 0..3 of the level) and advance the residues.
uint trit_word(inout uint vl, inout uint vh) {
    uint wl = MUL3(vl);
    uint wh = MUL3(vh);
    vl = wl & 0x00FF00FFu;
    vh = wh & 0x00FF00FFu;
    return ((wl >> 8u) & 0x00FF00FFu) | (wh & 0xFF00FF00u);
}

void main() {
    uint t = gl_LocalInvocationID.x;
    uint row0 = gl_WorkGroupID.x * TR;
    uint tok0 = gl_WorkGroupID.y * TM;

    // All rows of a tile share one segment (segment bounds are multiples of 64).
    uint wbase;
    uint out_off;
    uint seg_rows;
    uint seg_row0;
    if (row0 < p.seg1) {
        wbase = p.w0;
        out_off = p.out0;
        seg_row0 = row0;
        seg_rows = p.seg1;
    } else if (row0 < p.seg2) {
        wbase = p.w1;
        out_off = p.out1;
        seg_row0 = row0 - p.seg1;
        seg_rows = p.seg2 - p.seg1;
    } else {
        wbase = p.w2;
        out_off = p.out2;
        seg_row0 = row0 - p.seg2;
        seg_rows = p.total_rows - p.seg2;
    }

    uint rg = t >> 4u; // rows rg*4 .. +3
    uint tg = t & 15u; // tokens tg + 16*j
    float acc[4][4];
    [[unroll]] for (uint i = 0u; i < 4u; i += 1u) {
        [[unroll]] for (uint j = 0u; j < 4u; j += 1u) {
            acc[i][j] = 0.0;
        }
    }
    uint kw = p.nb * 32u; // activation words per token row

    for (uint b = 0u; b < p.nb; b += 1u) {
        // ---- decode 64 rows × 7 tasks (6 qs words + qh) -------------------
        for (uint task = t; task < TR * 7u; task += 256u) {
            uint r = task / 7u;
            uint i = task % 7u;
            uint wb = wbase + ((seg_row0 + r) * p.nb + b) * 7u;
            uint q = w[wb + i];
            if (i < 6u) {
                uint vl = q & 0x00FF00FFu;
                uint vh = (q >> 8u) & 0x00FF00FFu;
                [[unroll]] for (uint lv = 0u; lv < 5u; lv += 1u) {
                    uint word = trit_word(vl, vh);
                    uint dst = i < 4u ? 4u * lv + i : 20u + 2u * lv + (i - 4u);
                    w_sh[r][dst] = word;
                }
            } else {
                uint vq = (q & 0xFFu) | ((q & 0xFF00u) << 8u);
                uint wq;
                wq = MUL3(vq);
                vq = wq & 0x00FF00FFu;
                uint q01 = ((wq >> 8u) & 0x3u) | ((wq >> 16u) & 0x300u);
                wq = MUL3(vq);
                vq = wq & 0x00FF00FFu;
                q01 |= ((wq << 8u) & 0x30000u) | (wq & 0x03000000u);
                wq = MUL3(vq);
                vq = wq & 0x00FF00FFu;
                uint q23 = ((wq >> 8u) & 0x3u) | ((wq >> 16u) & 0x300u);
                wq = MUL3(vq);
                q23 |= ((wq << 8u) & 0x30000u) | (wq & 0x03000000u);
                w_sh[r][30] = q01;
                w_sh[r][31] = q23;
                dw_sh[r] = unpackHalf2x16(q).y;
            }
        }
        // ---- stage 64 token rows of activations ---------------------------
        for (uint idx = t; idx < TM * 32u; idx += 256u) {
            uint m = idx >> 5u;
            uint wi = idx & 31u;
            uint tok = tok0 + m;
            a_sh[m][wi] = tok < p.m_tokens ? q8[p.q8_qs + tok * kw + b * 32u + wi] : 0u;
        }
        if (t < TM) {
            uint tok = tok0 + t;
            bool ok = tok < p.m_tokens;
            da_sh[t] = ok ? uintBitsToFloat(q8[p.q8_d + tok * p.nb + b]) : 0.0;
            ds_sh[t] = ok ? uintBitsToFloat(q8[p.q8_s + tok * p.nb + b]) : 0.0;
        }
        barrier();

        int isum[4][4];
        [[unroll]] for (uint i = 0u; i < 4u; i += 1u) {
            [[unroll]] for (uint j = 0u; j < 4u; j += 1u) {
                isum[i][j] = 0;
            }
        }
        for (uint wi = 0u; wi < 32u; wi += 1u) {
            int wv[4];
            int av[4];
            [[unroll]] for (uint i = 0u; i < 4u; i += 1u) {
                wv[i] = int(w_sh[rg * 4u + i][wi]);
                av[i] = int(a_sh[tg + 16u * i][wi]);
            }
            [[unroll]] for (uint i = 0u; i < 4u; i += 1u) {
                [[unroll]] for (uint j = 0u; j < 4u; j += 1u) {
                    isum[i][j] = dotPacked4x8EXT(wv[i], av[j]) + isum[i][j];
                }
            }
        }
        [[unroll]] for (uint i = 0u; i < 4u; i += 1u) {
            float dw = dw_sh[rg * 4u + i];
            [[unroll]] for (uint j = 0u; j < 4u; j += 1u) {
                uint m = tg + 16u * j;
                acc[i][j] += dw * (da_sh[m] * float(isum[i][j]) - ds_sh[m]);
            }
        }
        barrier();
    }

    [[unroll]] for (uint j = 0u; j < 4u; j += 1u) {
        uint tok = tok0 + tg + 16u * j;
        if (tok < p.m_tokens) {
            [[unroll]] for (uint i = 0u; i < 4u; i += 1u) {
                uint o = out_off + tok * seg_rows + seg_row0 + rg * 4u + i;
                if ((p.flags & 1u) != 0u) {
                    act[o] += acc[i][j];
                } else {
                    act[o] = acc[i][j];
                }
            }
        }
    }
}
