#version 460

// Fused: y = silu(gate) * up  →  Q8_0 quantize  →  write to act_q8.
//
// Replaces the prefill-path pair `silu_mul` (writes act.ffn_in) +
// `quantize_q8_0` (reads act.ffn_in, writes act_q8). The fused version keeps
// each silu*up product in registers, computes per-32-block max-abs, and
// writes Q8_0 directly.
//
// Output layout (matches `quantize_q8_0`):
//   d (f32):  outbuf[d_offset/4 + token*nb_q8 + b]
//   qs (i8):  outbuf[qs_offset/4 + (token*k + b*32)/4 + sub] for sub in 0..8
//
// dispatch: (m, 1, 1) — one workgroup per token. Caller must guarantee
// `(k/32) % 8 == 0`, which holds for k = n_ff = 9728 on Bonsai 4B/8B.

layout(constant_id = 0) const uint SUBGROUP_SIZE = 32;

layout(push_constant) uniform Params {
    uint k;           // n_ff, multiple of 256
    uint gate_offset; // f16 elements
    uint up_offset;   // f16 elements
    uint d_offset;    // bytes (Q8_0 d-section, FP32 scales)
    uint qs_offset;   // bytes (Q8_0 qs-section, packed i8)
}
p;

layout(set = 0, binding = 0, std430) readonly buffer ActBuf { float16_t act[]; };
layout(set = 0, binding = 1, std430) buffer OutBuf { uint outbuf[]; };

const uint WG = 256u;
const uint BLOCK_SIZE = 32u;
const uint BLOCKS_PER_ITER = WG / BLOCK_SIZE; // 8
const uint NUM_SUBGROUPS = (WG + SUBGROUP_SIZE - 1u) / SUBGROUP_SIZE;

shared uint qv_sh[256];
shared float sg_partial_amax[NUM_SUBGROUPS];

#include "lib/q8_0_quantize.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint token_idx = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint nb_q8 = p.k / BLOCK_SIZE;
    uint g_base = p.gate_offset + token_idx * p.k;
    uint u_base = p.up_offset + token_idx * p.k;
    uint qs_token_byte = p.qs_offset + token_idx * p.k;
    uint d_token_word = (p.d_offset >> 2) + token_idx * nb_q8;

    uint lane_in_block = tid & 31u;
    uint block_within_iter = tid >> 5;

    uint n_iters = nb_q8 / BLOCKS_PER_ITER;
    for (uint it = 0u; it < n_iters; ++it) {
        uint block_global = it * BLOCKS_PER_ITER + block_within_iter;
        uint elem_idx = it * WG + tid;
        float g = float(act[g_base + elem_idx]);
        float silu = g / (1.0 + exp(-g));
        float v = silu * float(act[u_base + elem_idx]);

        float m = block_max_abs(v);
        float id_inv = mix(0.0, 127.0 / m, m != 0.0);
        uint qv = uint(int(clamp(round(v * id_inv), -127.0, 127.0))) & 0xFFu;

        uint packed;
        if (SUBGROUP_SIZE >= 32u) {
            packed = pack4(qv);
        } else {
            qv_sh[tid] = qv;
            barrier();
            uint base = (block_within_iter * 32u) + (lane_in_block & ~3u);
            packed = qv_sh[base + 0u] | (qv_sh[base + 1u] << 8) | (qv_sh[base + 2u] << 16) | (qv_sh[base + 3u] << 24);
            barrier();
        }
        if ((lane_in_block & 3u) == 0u) {
            uint qs_byte = qs_token_byte + block_global * 32u + lane_in_block;
            outbuf[qs_byte >> 2] = packed;
        }
        if (lane_in_block == 0u) {
            outbuf[d_token_word + block_global] = floatBitsToUint(m / 127.0);
        }
    }
}
