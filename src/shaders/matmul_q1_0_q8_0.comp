#version 460

// dotPacked4x8EXT matmul: Q1_0/Q2_0 weights × Q8_0 activations -> f16 output.
//
// 64×64 tile, 256 threads, each thread = 4×4 = 16 cells. The decode step
// (filling `w[TN][8]` packed-i8 weight quads per Q8_0 sub-block) branches on
// QUANT_FORMAT — Q1_0 unpacks 8 nibbles per qword via expand_4_bits, Q2_0
// unpacks 4 bytes from each of 2 qwords via expand_8_bits — but the TM × dp4a
// accumulation that consumes those quads is shared between formats.

layout(push_constant) uniform Params {
    uint k;
    uint n;
    uint m;
    uint w_d_offset;
    uint w_qs_offset;
    uint a_d_offset;
    uint a_qs_offset;
    uint out_offset;
    uint accumulate;
}
p;

layout(set = 0, binding = 0, std430) readonly buffer WBuf { uint weights[]; };
layout(set = 0, binding = 1, std430) readonly buffer ABuf { uint acts[]; };
layout(set = 0, binding = 2, std430) buffer YBuf { float16_t y[]; };

#include "lib/q1_0_load.glsl"

const uint WG_N = 16u;
const uint WG_M = 16u;
const uint WG = 256u;
const uint TN = 4u;
const uint TM = 4u;
const uint TILE_N = 64u;
const uint TILE_M = 64u;

shared float w_d_lds[64];
shared uint w_bits_lds[256 << QUANT_FORMAT];
shared float a_d_lds[256];
shared uint a_qs_lds[2048];

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint n_base = gl_WorkGroupID.x * TILE_N;
    uint m_base = gl_WorkGroupID.y * TILE_M;
    uint nb_q1 = p.k / 128u;
    uint nb_q8 = p.k / 32u;
    uint tid = gl_LocalInvocationIndex;

    uint lx = tid % WG_N;
    uint ly = tid / WG_N;

    float acc[16];
    [[unroll]] for (uint i = 0u; i < 16u; ++i)
        acc[i] = 0.0;

    // Bonsai's matmul callers guarantee tile alignment / activation buffer
    // padding; OOB loads stay in LDS slots only their owner consults, and
    // final writes are gated by m_idx < p.m.
    //
    // Loop hints: every Bonsai matmul caller picks K as a multiple of 512
    // (n_embd=2560/3072, q_dim=2048, ffn=9728), so nb_q1 = K/128 is always a
    // multiple of 4 and at least 16 (smallest case is Wo on 4B). The acc[]
    // update is a length-1 loop carry (associative reduction).
    [[unroll, min_iterations(16), iteration_multiple(4), dependency_length(1)]]
    for (uint b = 0u; b < nb_q1; ++b) {
        // ---- Cooperative loads ----
        if (tid < 64u) {
            uint n_idx = n_base + tid;
            w_d_lds[tid] = load_f16_at(p.w_d_offset + (n_idx * nb_q1 + b) * 2u);
        }
        // Each thread loads one qword per pass; Q1_0 = 1 pass, Q2_0 = 2 passes
        // (4 qwords/block × 64 rows = 256 loads per pass = 1 per thread).
        [[unroll]] for (uint pass = 0u; pass < (W_QWORDS_PER_BLOCK / 4u); ++pass) {
            uint n_local = tid / 4u;
            uint s = (tid % 4u) + pass * 4u;
            uint n_idx = n_base + n_local;
            uint off = p.w_qs_offset + n_idx * (nb_q1 * QS_BYTES_PER_BLOCK) + b * QS_BYTES_PER_BLOCK + s * 4u;
            w_bits_lds[s * 64u + n_local] = weights[off >> 2];
        }
        {
            uint s = tid / 64u;
            uint m_local = tid % 64u;
            uint m_idx = m_base + m_local;
            uint a_block = b * 4u + s;
            uint off = p.a_d_offset + (m_idx * nb_q8 + a_block) * 4u;
            a_d_lds[s * 64u + m_local] = uintBitsToFloat(acts[off >> 2]);
        }
        [[unroll]] for (uint li = 0u; li < 8u; ++li) {
            uint idx = li * WG + tid;
            uint m_local = idx / 32u;
            uint su = idx % 32u;
            uint m_idx = m_base + m_local;
            uint off = p.a_qs_offset + m_idx * p.k + b * 128u + su * 4u;
            a_qs_lds[m_local * 32u + su] = acts[off >> 2];
        }
        barrier();

        float wd[TN];
        [[unroll]] for (uint tn = 0u; tn < TN; ++tn) { wd[tn] = w_d_lds[lx * TN + tn]; }

        // 4 Q8_0 sub-blocks per Q1_0 block. The decode step differs by format
        // (Q1_0: 1 qword/sub-block, 8 nibbles via expand_4_bits; Q2_0: 2
        // qwords/sub-block, 4 bytes each via expand_8_bits) but the resulting
        // 8 packed-i8 weight quads feed an identical TM × dp4a accumulation.
        [[unroll]] for (uint s = 0u; s < 4u; ++s) {
            uint w[TN][8];
            if (QUANT_FORMAT == 0u) {
                [[unroll]] for (uint tn = 0u; tn < TN; ++tn) {
                    uint bw = w_bits_lds[s * 64u + lx * TN + tn];
                    [[unroll]] for (uint i = 0u; i < 8u; ++i) { w[tn][i] = expand_4_bits((bw >> (i * 4u)) & 0xFu); }
                }
            } else {
                [[unroll]] for (uint tn = 0u; tn < TN; ++tn) {
                    [[unroll]] for (uint wq = 0u; wq < 2u; ++wq) {
                        uint qword = w_bits_lds[(s * 2u + wq) * 64u + lx * TN + tn];
                        [[unroll]] for (uint i = 0u; i < 4u; ++i) {
                            w[tn][wq * 4u + i] = expand_8_bits((qword >> (i * 8u)) & 0xFFu);
                        }
                    }
                }
            }

            [[unroll]] for (uint tm = 0u; tm < TM; ++tm) {
                uint m_local = ly * TM + tm;
                float a_d = a_d_lds[s * 64u + m_local];
                uint a_base = m_local * 32u + s * 8u;
                uint a[8];
                [[unroll]] for (uint i = 0u; i < 8u; ++i) { a[i] = a_qs_lds[a_base + i]; }

                int sumi[TN];
                [[unroll]] for (uint tn = 0u; tn < TN; ++tn)
                    sumi[tn] = 0;
                [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                    [[unroll]] for (uint tn = 0u; tn < TN; ++tn) {
                        sumi[tn] = dotPacked4x8EXT(int(w[tn][i]), int(a[i])) + sumi[tn];
                    }
                }

                [[unroll]] for (uint tn = 0u; tn < TN; ++tn) { acc[tm * TN + tn] += a_d * wd[tn] * float(sumi[tn]); }
            }
        }
        barrier();
    }

    [[unroll]] for (uint tm = 0u; tm < TM; ++tm) {
        uint m_idx = m_base + ly * TM + tm;
        if (m_idx >= p.m)
            continue;
        [[unroll]] for (uint tn = 0u; tn < TN; ++tn) {
            uint n_idx = n_base + lx * TN + tn;
            if (n_idx >= p.n)
                continue;
            uint yi = p.out_offset + m_idx * p.n + n_idx;
            float val = acc[tm * TN + tn];
            y[yi] = float16_t(mix(0.0, float(y[yi]), p.accumulate != 0u) + val);
        }
    }
}
